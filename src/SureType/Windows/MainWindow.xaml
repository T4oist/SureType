<Window x:Class="SureType.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="940" Height="750" MinWidth="680" MinHeight="500" WindowStartupLocation="CenterScreen"
 Background="#F7F7F2" Foreground="#252E29" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13"
 UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Ink" Color="#252E29"/>
  <SolidColorBrush x:Key="Muted" Color="#6C776E"/>
  <SolidColorBrush x:Key="Accent" Color="#315D49"/>
  <SolidColorBrush x:Key="Line" Color="#E0E5DD"/>
  <Style TargetType="TextBlock">
   <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="Heading" TargetType="TextBlock">
   <Setter Property="FontSize" Value="28"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>
  <Style x:Key="SectionLabel" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/>
   <Setter Property="Margin" Value="0,0,0,12"/>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#E9EDE5"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="16,9"/><Setter Property="MinHeight" Value="38"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
   <EventSetter Event="MouseEnter" Handler="Button_Enter"/><EventSetter Event="MouseLeave" Handler="Button_Leave"/>
   <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Button_Down"/><EventSetter Event="PreviewMouseLeftButtonUp" Handler="Button_Up"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="Button">
     <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10"
      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.88"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.70"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#78A48B"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/>
  </Style>
  <Style x:Key="NavigationItem" TargetType="ListBoxItem">
   <Setter Property="Padding" Value="16,13"/><Setter Property="Margin" Value="0,0,0,5"/>
   <Setter Property="Foreground" Value="#69746C"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Tile" Background="Transparent" CornerRadius="11" BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
     <ContentPresenter/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="#EEF1E9"/></Trigger>
     <Trigger Property="IsSelected" Value="True">
      <Setter TargetName="Tile" Property="Background" Value="#E3EBDD"/><Setter Property="Foreground" Value="#244A35"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
     </Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="#80A28D"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Padding" Value="11,9"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
    <Border x:Name="Item" CornerRadius="7" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#EAF0E5"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#315D49"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="MinHeight" Value="40"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/>
   <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid>
     <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
       <Border x:Name="ComboShell" CornerRadius="10" BorderThickness="1" BorderBrush="#DCE2D8" Background="White">
        <Path Data="M 0 0 L 4 4 L 8 0" Stroke="#758271" StrokeThickness="1.4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0"/>
       </Border>
       <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboShell" Property="BorderBrush" Value="#90A58D"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="13,0,34,0" VerticalAlignment="Center"/>
     <Border x:Name="FocusRing" CornerRadius="10" BorderThickness="1" BorderBrush="Transparent" IsHitTestVisible="False"/>
     <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
      <Border Margin="0,5,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Background="White" BorderBrush="#DCE2D8" BorderThickness="1" CornerRadius="11" Padding="5">
       <ScrollViewer MaxHeight="260" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
      </Border>
     </Popup>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusRing" Property="BorderBrush" Value="#709679"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="MinHeight" Value="52"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <Grid Background="Transparent">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ContentPresenter VerticalAlignment="Center" Margin="0,6,20,6" RecognizesAccessKey="True"/>
     <Border x:Name="Rail" Grid.Column="1" Width="38" Height="22" CornerRadius="11" Background="#CFD6C9" VerticalAlignment="Center" BorderThickness="1" BorderBrush="Transparent">
      <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="2,0"/>
     </Border>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Rail" Property="Background" Value="#3C6B50"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Rail" Property="Opacity" Value="0.8"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Rail" Property="BorderBrush" Value="#223F2F"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="TrackButton" TargetType="RepeatButton">
   <Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
    <Border Height="4" Background="{TemplateBinding Background}" CornerRadius="2" VerticalAlignment="Center"/>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Slider">
   <Setter Property="Height" Value="28"/><Setter Property="Margin" Value="0,8,0,0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
    <Grid Background="Transparent">
     <Track x:Name="PART_Track">
      <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource TrackButton}" Command="{x:Static Slider.DecreaseLarge}" Background="#567B58"/></Track.DecreaseRepeatButton>
      <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource TrackButton}" Command="{x:Static Slider.IncreaseLarge}" Background="#DBE1D5"/></Track.IncreaseRepeatButton>
      <Track.Thumb><Thumb Width="17" Height="17" Cursor="Hand"><Thumb.Template><ControlTemplate TargetType="Thumb">
       <Ellipse Fill="White" Stroke="#456B4E" StrokeThickness="2"/>
      </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     </Track>
     <Border x:Name="SliderFocus" BorderThickness="1" BorderBrush="Transparent" CornerRadius="7" IsHitTestVisible="False"/>
    </Grid>
    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SliderFocus" Property="BorderBrush" Value="#91AB8A"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DCE2D8"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Border x:Name="Input" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
     <ScrollViewer x:Name="PART_ContentHost"/>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Input" Property="BorderBrush" Value="#537D5B"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="166"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#F0F2EB" BorderBrush="#E5E9DF" BorderThickness="0,0,1,0">
   <DockPanel Margin="18,26,18,22">
    <StackPanel DockPanel.Dock="Top" Margin="10,0,0,36">
     <Border Width="36" Height="36" CornerRadius="11" Background="#315D49" HorizontalAlignment="Left" Margin="0,0,0,12">
      <TextBlock Text="S" Foreground="#F6F8F1" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <TextBlock Text="SureType" FontSize="19" FontWeight="SemiBold"/>
     <TextBlock x:Name="SubtitleText" FontSize="11" Foreground="#7D887B" Margin="0,5,0,0"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="10,0,0,0">
     <StackPanel Orientation="Horizontal">
      <Ellipse x:Name="RuntimeDot" Width="6" Height="6" Fill="#557C53" Margin="0,0,7,0"/>
      <TextBlock x:Name="RuntimeText" Foreground="#60715D" FontSize="11"/>
     </StackPanel>
     <TextBlock Text="v0.2.1" Foreground="#8B9585" FontSize="10" Margin="13,8,0,0"/>
    </StackPanel>
    <ListBox Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavigationItem}"
     SelectedIndex="{Binding SelectedIndex, ElementName=Tabs, Mode=TwoWay}" VerticalAlignment="Top" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBoxItem x:Name="GuideNav"/><ListBoxItem x:Name="AppearanceNav"/><ListBoxItem x:Name="BehaviorNav"/>
    </ListBox>
   </DockPanel>
  </Border>
  <DockPanel Grid.Column="1" Margin="30,28,30,18">
   <Border DockPanel.Dock="Top" Margin="0,0,0,12" Background="#FAEDE6" CornerRadius="10" Padding="12"
    Visibility="{Binding Visibility, ElementName=ErrorText}">
    <TextBlock x:Name="ErrorText" Foreground="#8E4833" FontSize="12" Visibility="Collapsed"/>
   </Border>
   <TextBlock x:Name="FooterText" DockPanel.Dock="Bottom" Foreground="#818C7D" FontSize="11" Margin="0,18,0,0"/>
   <TabControl x:Name="Tabs" SelectionChanged="Tabs_Changed" BorderThickness="0" Background="Transparent">
    <TabControl.Template><ControlTemplate TargetType="TabControl">
     <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
    </ControlTemplate></TabControl.Template>
    <TabItem x:Name="GuideTab">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
      <StackPanel>
       <TextBlock x:Name="GuideTitle" Style="{StaticResource Heading}"/>
       <TextBlock x:Name="GuideText" Foreground="{StaticResource Muted}" Margin="0,0,0,26"/>
       <Border Background="#E8EEDC" CornerRadius="18" Padding="24" Margin="0,0,0,24">
        <StackPanel>
         <Grid Margin="0,0,0,12">
          <TextBlock x:Name="TryLabel" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock x:Name="LiveStateText" HorizontalAlignment="Right" Foreground="#315D49" FontWeight="SemiBold" Text="—"/>
         </Grid>
         <Grid>
          <TextBox x:Name="TryInput" Height="118" AcceptsReturn="True" TextWrapping="Wrap"
           GotKeyboardFocus="TryInput_Focused" AutomationProperties.Name="Try typing"/>
          <TextBlock x:Name="InputPlaceholder" Margin="17" Foreground="#98A091" IsHitTestVisible="False">
           <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=TryInput}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
           </Style></TextBlock.Style>
          </TextBlock>
         </Grid>
         <TextBlock x:Name="PrivacyHint" FontSize="11" Foreground="#77866A" Margin="1,10,0,0"/>
        </StackPanel>
       </Border>
       <TextBlock x:Name="LegendLabel" Style="{StaticResource SectionLabel}"/>
       <ItemsControl x:Name="LegendItems" Margin="0,0,0,20">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate>
         <StackPanel Orientation="Horizontal" Width="126" Margin="0,0,8,16">
          <Border Width="36" Height="36" CornerRadius="10" Background="{Binding Background}" Margin="0,0,10,0">
           <TextBlock Text="{Binding Symbol}" Foreground="{Binding Foreground}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
          </Border>
          <TextBlock Text="{Binding Label}" Width="78" VerticalAlignment="Center" FontSize="12" Foreground="#576450"/>
         </StackPanel>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
       <WrapPanel><Button x:Name="BeginButton" Style="{StaticResource PrimaryButton}" Click="Begin_Click" Margin="0,0,10,0"/>
        <Button x:Name="PreviewGuideButton" Click="Preview_Click"/></WrapPanel>
      </StackPanel>
     </ScrollViewer>
    </TabItem>
    <TabItem x:Name="AppearanceTab">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
      <StackPanel>
       <Grid Margin="0,0,0,22">
        <TextBlock x:Name="AppearanceTitle" Style="{StaticResource Heading}" Margin="0" VerticalAlignment="Center"/>
        <Button x:Name="PreviewButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="Preview_Click"/>
       </Grid>
       <Border Background="#E9EDDF" CornerRadius="18" BorderBrush="#E2E7D8" BorderThickness="1" ClipToBounds="True">
        <Canvas x:Name="PreviewCanvas" Height="180" SizeChanged="Preview_SizeChanged">
         <Border x:Name="PreviewDocument" Width="260" Height="116" Canvas.Left="100" Canvas.Top="32" CornerRadius="10" Background="#F9FAF5" BorderBrush="#DEE4D4" BorderThickness="1">
          <StackPanel Margin="16">
           <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
            <Ellipse Width="5" Height="5" Fill="#C8D1BC" Margin="0,0,5,0"/><Ellipse Width="5" Height="5" Fill="#D8DECE" Margin="0,0,5,0"/><Ellipse Width="5" Height="5" Fill="#D8DECE"/>
           </StackPanel>
           <Border Background="#E1E6D8" Height="5" Width="110" CornerRadius="2" HorizontalAlignment="Left" Margin="0,0,0,9"/>
           <Border Background="#E8ECDF" Height="5" Width="158" CornerRadius="2" HorizontalAlignment="Left" Margin="0,0,0,13"/>
           <Border Background="#759164" Height="13" Width="1.5" HorizontalAlignment="Left"/>
          </StackPanel>
         </Border>
         <Path x:Name="PreviewCursor" Data="M0,0 L0,23 L6,17 L12,29 L16,27 L10,15 L20,15 Z" Fill="#344738" Stroke="#F9FAF5" StrokeThickness="1.5"/>
         <Border x:Name="PreviewBadge" Width="56" Height="56" Background="#315D49" CornerRadius="14" BorderThickness="1" BorderBrush="#315D49" RenderTransformOrigin="0.5,0.5">
          <Border.RenderTransform><TransformGroup><ScaleTransform x:Name="PreviewScale"/><TranslateTransform x:Name="PreviewMotion"/></TransformGroup></Border.RenderTransform>
          <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.14" Color="#3F523A"/></Border.Effect>
          <Viewbox Margin="5"><TextBlock x:Name="PreviewSymbol" Text="中" Width="40" Height="40" TextAlignment="Center" Padding="0,7,0,0" FontSize="19" FontWeight="SemiBold" Foreground="White"/></Viewbox>
         </Border>
        </Canvas>
       </Border>
       <Grid Margin="2,10,2,24">
        <TextBlock x:Name="PreviewCaptionText" Style="{StaticResource SectionLabel}" Margin="0"/>
        <TextBlock x:Name="PreviewModeText" HorizontalAlignment="Right" Foreground="#607153" FontSize="12"/>
       </Grid>
       <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel>
         <TextBlock x:Name="PositionLabel" Margin="0,0,0,9"/>
         <ComboBox x:Name="PositionCombo" SelectionChanged="Preferences_Changed" AutomationProperties.Name="Position"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
         <TextBlock x:Name="StyleLabel" Margin="0,0,0,9"/>
         <ComboBox x:Name="StyleCombo" SelectionChanged="Preferences_Changed" AutomationProperties.Name="Style"/>
        </StackPanel>
       </Grid>
       <TextBlock x:Name="PositionHint" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,25"/>
       <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,22"/>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock x:Name="SizeLabel"/>
         <Slider x:Name="SizeSlider" Minimum="40" Maximum="96" TickFrequency="8" IsSnapToTickEnabled="True" ValueChanged="Slider_Changed" AutomationProperties.Name="Size"/>
        </StackPanel>
        <StackPanel Grid.Column="2"><TextBlock x:Name="DurationLabel"/>
         <Slider x:Name="DurationSlider" Minimum="0.5" Maximum="5" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="Slider_Changed" AutomationProperties.Name="Duration"/>
        </StackPanel>
       </Grid>
      </StackPanel>
     </ScrollViewer>
    </TabItem>
    <TabItem x:Name="BehaviorTab">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
      <StackPanel>
       <TextBlock x:Name="BehaviorTitle" Style="{StaticResource Heading}" Margin="0,0,0,22"/>
       <Grid Margin="0,0,0,8">
        <TextBlock x:Name="LanguageLabel" VerticalAlignment="Center"/>
        <ComboBox x:Name="LanguageCombo" Width="142" HorizontalAlignment="Right" SelectionChanged="Language_Changed" AutomationProperties.Name="Language">
         <ComboBoxItem Content="中文"/><ComboBoxItem Content="English"/>
        </ComboBox>
       </Grid>
       <CheckBox x:Name="StartupCheck" Click="Startup_Click"/>
       <Border Height="1" Background="{StaticResource Line}" Margin="0,10,0,12"/>
       <CheckBox x:Name="ChangesCheck" Click="Preferences_Changed"/>
       <CheckBox x:Name="FocusCheck" Click="Preferences_Changed"/>
       <CheckBox x:Name="FullscreenCheck" Click="Preferences_Changed"/>
       <Grid Margin="0,14,0,20">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <TextBlock x:Name="CooldownLabel" VerticalAlignment="Center"/>
        <Slider Grid.Column="1" x:Name="CooldownSlider" Minimum="1" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_Changed" AutomationProperties.Name="Focus cooldown" Margin="16,0,0,0"/>
       </Grid>
       <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,22"/>
       <TextBlock x:Name="ExclusionsLabel" Margin="0,0,0,12"/>
       <Grid>
        <ListBox x:Name="ExclusionsList" Height="74" Background="#EFF2E9" BorderThickness="0" Padding="8" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Excluded apps">
         <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" ToolTip="{Binding}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="11"/></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="EmptyExclusionsText" Foreground="#8B9683" FontSize="12" Margin="16,0" VerticalAlignment="Center" IsHitTestVisible="False">
         <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=ExclusionsList}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
         </Style></TextBlock.Style>
        </TextBlock>
       </Grid>
       <WrapPanel Margin="0,10,0,22"><Button x:Name="AddButton" Click="Add_Click" Margin="0,0,8,0"/><Button x:Name="RemoveButton" Click="Remove_Click"/></WrapPanel>
       <WrapPanel><Button x:Name="PauseButton" Click="Pause_Click" Margin="0,0,8,0"/><Button x:Name="ResetButton" Click="Reset_Click" Background="Transparent" Foreground="#72806C"/></WrapPanel>
      </StackPanel>
     </ScrollViewer>
    </TabItem>
   </TabControl>
  </DockPanel>
 </Grid>
</Window>
