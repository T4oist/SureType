<Window x:Class="SureType.Windows.OverlayWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="56" Height="56" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
 ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
 Focusable="False" IsHitTestVisible="False" Opacity="0" Visibility="Hidden">
 <Viewbox Margin="4" RenderTransformOrigin="0.5,0.5">
  <Viewbox.RenderTransform><ScaleTransform x:Name="BadgeScale"/></Viewbox.RenderTransform>
  <Border x:Name="StatusShell" Width="50" Height="50" CornerRadius="14" BorderThickness="1">
   <Border.Effect><DropShadowEffect BlurRadius="7" ShadowDepth="1" Opacity="0.14" Color="#28382A"/></Border.Effect>
   <Grid>
    <TextBlock x:Name="StatusText" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="18" FontWeight="SemiBold"
     HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <Border x:Name="CapsBadge" Background="#FF242933" CornerRadius="3" VerticalAlignment="Bottom" HorizontalAlignment="Right" Padding="3,0">
     <TextBlock Text="⇪" Foreground="White" FontSize="12" AutomationProperties.Name="Caps Lock on"/>
    </Border>
   </Grid>
  </Border>
 </Viewbox>
</Window>
